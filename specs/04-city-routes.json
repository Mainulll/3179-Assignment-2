{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 420,
  "height": 510,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 500,
      "labelColor": "#52635F",
      "titleColor": "#203C3A",
      "domain": false,
      "tickColor": "#DDD6C9",
      "gridColor": "#E8E2D7",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#52635F",
      "titleColor": "#203C3A"
    },
    "text": {
      "font": "Manrope",
      "color": "#203C3A"
    },
    "title": {
      "font": "Fraunces",
      "color": "#203C3A"
    }
  },
  "description": "34 separate LineString components for 11 self-guided routes. Components are never joined across gaps. Cycling is derived from the exact route name Southbank and Docklands by Bike.",
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "routeFilter",
      "value": "All"
    },
    {
      "name": "mapDetail",
      "value": 3
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/dv2/routes-parks.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DCE6CD",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/dv2/routes-water.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#B7D8DF",
        "stroke": "#95BBC7",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/dv2/routes-streets.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#CCD0C8",
        "strokeWidth": 0.75
      }
    },
    {
      "data": {
        "url": "data/dv2/walks.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeWidth": 3.2
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "routeFilter === 'All' || datum.properties.route_name === routeFilter",
            "field": "properties.mode",
            "type": "nominal",
            "scale": {
              "domain": [
                "Walking",
                "Cycling"
              ],
              "range": [
                "#A6472D",
                "#176C65"
              ]
            },
            "legend": null
          },
          "value": "#BCC8BE"
        },
        "opacity": {
          "condition": {
            "test": "routeFilter === 'All' || datum.properties.route_name === routeFilter",
            "value": 0.9
          },
          "value": 0.15
        },
        "strokeDash": {
          "field": "properties.mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Walking",
              "Cycling"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                3
              ]
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.route_name",
            "title": "Route",
            "type": "nominal"
          },
          {
            "field": "properties.mode",
            "title": "Mode",
            "type": "nominal"
          },
          {
            "field": "properties.geometry_length_km",
            "title": "Derived whole-route km",
            "type": "quantitative",
            "format": ".2f"
          },
          {
            "field": "properties.part_id",
            "title": "Component",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/dv2/routes-labels.json"
      },
      "transform": [
        {
          "filter": "datum.kind === 'street' && datum.priority <= mapDetail"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 10,
        "color": "#68756E"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/dv2/routes-labels.json"
      },
      "transform": [
        {
          "filter": "datum.kind !== 'street' && datum.priority <= mapDetail"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#304E48",
        "dy": -11
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/dv2/route-endpoint-groups.json"
      },
      "transform": [
        {
          "filter": "routeFilter !== 'All' && datum.route_name === routeFilter"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 330,
        "fill": "#FFFDF8",
        "stroke": "#203C3A",
        "strokeWidth": 1.4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "route_name",
            "title": "Route",
            "type": "nominal"
          },
          {
            "field": "endpoints",
            "title": "Source endpoints",
            "type": "nominal"
          },
          {
            "field": "kind",
            "title": "Endpoint",
            "type": "nominal"
          },
          {
            "field": "meaning",
            "title": "Interpretation",
            "type": "nominal"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/dv2/route-endpoint-groups.json"
      },
      "transform": [
        {
          "filter": "routeFilter !== 'All' && datum.route_name === routeFilter"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 9,
        "fontWeight": 800,
        "color": "#203C3A"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
