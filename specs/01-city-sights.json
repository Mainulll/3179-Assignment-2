{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 420,
  "height": 460,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 500,
      "labelColor": "#52635F",
      "titleColor": "#203C3A",
      "domain": false,
      "tickColor": "#DDD6C9",
      "gridColor": "#E8E2D7",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#52635F",
      "titleColor": "#203C3A"
    },
    "text": {
      "font": "Manrope",
      "color": "#203C3A"
    },
    "title": {
      "font": "Fraunces",
      "color": "#203C3A"
    }
  },
  "description": "Equal-sized cultural/leisure inventory points within the City of Melbourne. Source processed November 2022. Shapes and colours encode theme, not popularity.",
  "projection": {
    "type": "mercator"
  },
  "params": [
    {
      "name": "themeFilter",
      "value": "All"
    },
    {
      "name": "subFilter",
      "value": "All"
    },
    {
      "name": "mapDetail",
      "value": 2
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/dv2/city-parks.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DCE6CD",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/dv2/city-water.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#B7D8DF",
        "stroke": "#95BBC7",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/dv2/city-streets.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#CCD0C8",
        "strokeWidth": 0.75
      }
    },
    {
      "data": {
        "url": "data/dv2/sights.json"
      },
      "transform": [
        {
          "filter": "themeFilter === 'All' || datum.theme === themeFilter"
        },
        {
          "filter": "subFilter === 'All' || datum.sub_theme === subFilter"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 76,
        "opacity": 0.88,
        "stroke": "#FFFDF8",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "theme",
          "type": "nominal",
          "scale": {
            "domain": [
              "Leisure/Recreation",
              "Place Of Assembly",
              "Purpose Built"
            ],
            "range": [
              "#176C65",
              "#A6472D",
              "#8B5B11"
            ]
          },
          "legend": null
        },
        "shape": {
          "field": "theme",
          "type": "nominal",
          "scale": {
            "domain": [
              "Leisure/Recreation",
              "Place Of Assembly",
              "Purpose Built"
            ],
            "range": [
              "circle",
              "square",
              "triangle-up"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "feature_name",
            "title": "Place",
            "type": "nominal"
          },
          {
            "field": "sub_theme",
            "title": "Source type",
            "type": "nominal"
          },
          {
            "field": "theme",
            "title": "Source theme",
            "type": "nominal"
          },
          {
            "field": "clue_area",
            "title": "CLUE area",
            "type": "nominal"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/dv2/city-labels.json"
      },
      "transform": [
        {
          "filter": "datum.kind === 'street' && datum.priority <= mapDetail"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 10,
        "color": "#68756E"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/dv2/city-labels.json"
      },
      "transform": [
        {
          "filter": "datum.kind !== 'street' && datum.priority <= mapDetail"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Manrope",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#304E48",
        "dy": -11
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
