{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 420,
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Manrope",
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 500,
      "labelColor": "#52635F",
      "titleColor": "#203C3A",
      "domain": false,
      "tickColor": "#DDD6C9",
      "gridColor": "#E8E2D7",
      "labelPadding": 7,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#52635F",
      "titleColor": "#203C3A"
    },
    "text": {
      "font": "Manrope",
      "color": "#203C3A"
    },
    "title": {
      "font": "Fraunces",
      "color": "#203C3A"
    }
  },
  "description": "All 169 selected artwork distances in the same five CLUE areas; no observations omitted. Exact x distances in metres; deterministic vertical offsets carry no quantity. Violin width is Gaussian estimated probability density per area, not count. Shared pooled Silverman bandwidth 33.512 metres; density restricted to each observed range. A directly labelled median summarises each area. Straight-line, not walking distance.",
  "data": {
    "url": "data/dv2/art-toilets.json"
  },
  "transform": [
    {
      "calculate": "datum.area_label === \"Melbourne CBD · n=45\" ? 0 : datum.area_label === \"Melbourne remainder · n=45\" ? 1 : datum.area_label === \"East Melbourne · n=32\" ? 2 : datum.area_label === \"Carlton · n=16\" ? 3 : datum.area_label === \"Docklands · n=31\" ? 4 : 0",
      "as": "area_row"
    },
    {
      "calculate": "datum.area_row + ((toNumber(datum.asset_id) % 7) - 3) * 0.065",
      "as": "dot_row"
    }
  ],
  "encoding": {
    "x": {
      "field": "metres",
      "type": "quantitative",
      "title": "Straight-line distance (m)",
      "scale": {
        "domain": [
          0,
          900
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0,
          200,
          400,
          600,
          800
        ]
      }
    },
    "y": {
      "field": "dot_row",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          4.55,
          -0.55
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0,
          1,
          2,
          3,
          4
        ],
        "grid": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelLimit": 140,
        "labelLineHeight": 15,
        "labelExpr": "datum.value === 0 ? ['Melbourne CBD','n=45'] : datum.value === 1 ? ['Melbourne remainder','n=45'] : datum.value === 2 ? ['East Melbourne','n=32'] : datum.value === 3 ? ['Carlton','n=16'] : ['Docklands','n=31']"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "density": "metres",
          "groupby": [
            "area_row"
          ],
          "bandwidth": 33.512,
          "resolve": "independent",
          "counts": false,
          "steps": 181,
          "as": [
            "distance",
            "density"
          ]
        },
        {
          "calculate": "datum.area_row - datum.density * 25",
          "as": "density_top"
        },
        {
          "calculate": "datum.area_row + datum.density * 25",
          "as": "density_bottom"
        }
      ],
      "mark": {
        "type": "area",
        "orient": "vertical",
        "fill": "#D6E6E1",
        "stroke": "#88B0A7",
        "strokeWidth": 1,
        "opacity": 0.85
      },
      "encoding": {
        "detail": {
          "field": "area_row",
          "type": "nominal"
        },
        "x": {
          "field": "distance",
          "type": "quantitative"
        },
        "y": {
          "field": "density_top",
          "type": "quantitative"
        },
        "y2": {
          "field": "density_bottom"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 26,
        "opacity": 0.65,
        "color": "#176C65"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "title",
            "title": "Artwork",
            "type": "nominal"
          },
          {
            "field": "area",
            "title": "CLUE area",
            "type": "nominal"
          },
          {
            "field": "metres",
            "title": "Straight-line metres",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "metres",
              "as": "median_metres"
            }
          ],
          "groupby": [
            "area_row",
            "area_label"
          ]
        }
      ],
      "mark": {
        "type": "tick",
        "orient": "vertical",
        "size": 31,
        "thickness": 3,
        "color": "#A6472D",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "median_metres",
          "type": "quantitative"
        },
        "y": {
          "field": "area_row",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "area_label",
            "title": "Area / sample",
            "type": "nominal"
          },
          {
            "field": "median_metres",
            "title": "Median metres",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "metres",
              "as": "median_metres"
            }
          ],
          "groupby": [
            "area_row"
          ]
        },
        {
          "calculate": "format(datum.median_metres, '.0f') + ' m median'",
          "as": "median_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -25,
        "align": "left",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#A6472D"
      },
      "encoding": {
        "x": {
          "field": "median_metres",
          "type": "quantitative"
        },
        "y": {
          "field": "area_row",
          "type": "quantitative"
        },
        "text": {
          "field": "median_label"
        }
      }
    }
  ]
}
